<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.proyectofinalp.viewController.ReporteviewController"
            style="-fx-background-color: #ECF0F1;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #2C3E50; -fx-padding: 20;">
            <Button fx:id="btnVolver" text="⬅ Volver" onAction="#volverMenu"
                    style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-size: 14; -fx-background-radius: 5;"/>
            <Label text="Reportes y Estadísticas" textFill="white">
                <font>
                    <Font name="System Bold" size="28"/>
                </font>
            </Label>
        </HBox>
    </top>

    <center>
        <VBox spacing="20" style="-fx-padding: 20;">

            <!-- Selector de Tipo de Reporte -->
            <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;">
                <Label text="Tipo de Reporte" style="-fx-font-size: 18; -fx-font-weight: bold;"/>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Seleccione reporte:"/>
                    <ComboBox fx:id="comboTipoReporte" promptText="Elegir tipo de reporte" prefWidth="300"/>
                    <Button text="📊 Generar" onAction="#generarReporte"
                            style="-fx-background-color: #3498DB; -fx-text-fill: white; -fx-font-size: 14; -fx-background-radius: 5;" prefWidth="120"/>
                </HBox>
            </VBox>

            <!-- Estadísticas Generales -->
            <GridPane hgap="15" vgap="15">
                <!-- Card 1 -->
                <VBox spacing="10" alignment="CENTER" GridPane.columnIndex="0" GridPane.rowIndex="0"
                      style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                    <Label text="👨‍🎓" style="-fx-font-size: 36;"/>
                    <Label fx:id="lblTotalEstudiantes" text="0" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #3498DB;"/>
                    <Label text="Total Estudiantes" style="-fx-font-size: 14;"/>
                </VBox>

                <!-- Card 2 -->
                <VBox spacing="10" alignment="CENTER" GridPane.columnIndex="1" GridPane.rowIndex="0"
                      style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                    <Label text="👨‍🏫" style="-fx-font-size: 36;"/>
                    <Label fx:id="lblTotalProfesores" text="0" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #27AE60;"/>
                    <Label text="Total Profesores" style="-fx-font-size: 14;"/>
                </VBox>

                <!-- Card 3 -->
                <VBox spacing="10" alignment="CENTER" GridPane.columnIndex="2" GridPane.rowIndex="0"
                      style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                    <Label text="📚" style="-fx-font-size: 36;"/>
                    <Label fx:id="lblTotalCursos" text="0" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #F39C12;"/>
                    <Label text="Total Cursos" style="-fx-font-size: 14;"/>
                </VBox>

                <!-- Card 4 -->
                <VBox spacing="10" alignment="CENTER" GridPane.columnIndex="3" GridPane.rowIndex="0"
                      style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                    <Label text="🎓" style="-fx-font-size: 36;"/>
                    <Label fx:id="lblTotalClases" text="0" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #E74C3C;"/>
                    <Label text="Total Clases" style="-fx-font-size: 14;"/>
                </VBox>
            </GridPane>

            <!-- Área de Visualización -->
            <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;">
                <Label text="Detalles del Reporte" style="-fx-font-size: 18; -fx-font-weight: bold;"/>

                <TextArea fx:id="areaReporte" prefHeight="300" editable="false"
                          style="-fx-font-family: 'Courier New'; -fx-font-size: 12;"/>

                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button text="💾 Exportar PDF" onAction="#exportarPDF"
                            style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-size: 14; -fx-background-radius: 5;" prefWidth="130"/>
                    <Button text="📄 Exportar Excel" onAction="#exportarExcel"
                            style="-fx-background-color: #27AE60; -fx-text-fill: white; -fx-font-size: 14; -fx-background-radius: 5;" prefWidth="130"/>
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>