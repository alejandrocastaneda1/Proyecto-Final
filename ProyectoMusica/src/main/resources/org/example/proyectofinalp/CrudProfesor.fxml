<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.proyectofinalp.viewController.ProfesorviewController"
            style="-fx-background-color: #ECF0F1;">

    <!-- Header -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #2C3E50; -fx-padding: 20;">
            <Button fx:id="btnVolver" text="⬅ Volver" onAction="#volverMenu"
                    style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-size: 14; -fx-background-radius: 5;"/>
            <Label text="Gestión de Profesores" textFill="white">
                <font>
                    <Font name="System Bold" size="28"/>
                </font>
            </Label>
        </HBox>
    </top>

    <!-- Centro -->
    <center>
        <VBox spacing="20" style="-fx-padding: 20;">

            <!-- Panel de Formulario -->
            <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;">
                <Label text="Datos del Profesor" style="-fx-font-size: 18; -fx-font-weight: bold;"/>

                <GridPane hgap="10" vgap="15">
                    <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="txtNombre" promptText="Ingrese nombre" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="200"/>

                    <Label text="Apellido:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <TextField fx:id="txtApellido" promptText="Ingrese apellido" GridPane.columnIndex="3" GridPane.rowIndex="0" prefWidth="200"/>

                    <Label text="ID Profesor:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="txtIdProfesor" promptText="PROF001" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Contacto:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    <TextField fx:id="txtContacto" promptText="Teléfono" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                    <Label text="Correo:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <TextField fx:id="txtCorreo" promptText="email@ejemplo.com" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                    <Label text="Identificación:" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                    <TextField fx:id="txtIdentificacion" promptText="Documento" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
                </GridPane>

                <!-- Botones de Acción -->
                <HBox spacing="10" alignment="CENTER">
                    <Button fx:id="btnAgregar" text="➕ Agregar" onAction="#agregarProfesor"
                            style="-fx-background-color: #27AE60; -fx-text-fill: white; -fx-font-size: 14; -fx-background-radius: 5;" prefWidth="120"/>
                    <Button fx:id="btnModificar" text="✏️ Modificar" onAction="#modificarProfesor"
                            style="-fx-background-color: #F39C12; -fx-text-fill: white; -fx-font-size: 14; -fx-background-radius: 5;" prefWidth="120"/>
                    <Button fx:id="btnEliminar" text="🗑️ Eliminar" onAction="#eliminarProfesor"
                            style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-size: 14; -fx-background-radius: 5;" prefWidth="120"/>
                    <Button fx:id="btnLimpiar" text="🔄 Limpiar" onAction="#limpiarCampos"
                            style="-fx-background-color: #95A5A6; -fx-text-fill: white; -fx-font-size: 14; -fx-background-radius: 5;" prefWidth="120"/>
                </HBox>
            </VBox>

            <!-- Tabla de Profesores -->
            <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;">
                <Label text="Lista de Profesores" style="-fx-font-size: 18; -fx-font-weight: bold;"/>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Buscar:"/>
                    <TextField fx:id="txtBuscar" promptText="Buscar por nombre o ID..." prefWidth="300"/>
                    <Button text="🔍 Buscar" onAction="#buscarProfesor"
                            style="-fx-background-color: #3498DB; -fx-text-fill: white;"/>
                </HBox>

                <TableView fx:id="tablaProfesores" prefHeight="300">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="100"/>
                        <TableColumn fx:id="colNombre" text="Nombre" prefWidth="150"/>
                        <TableColumn fx:id="colApellido" text="Apellido" prefWidth="150"/>
                        <TableColumn fx:id="colContacto" text="Contacto" prefWidth="120"/>
                        <TableColumn fx:id="colCorreo" text="Correo" prefWidth="200"/>
                        <TableColumn fx:id="colIdentificacion" text="Identificación" prefWidth="120"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>