<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.proyectofinalp.viewController.CursoviewController"
            style="-fx-background-color: #ECF0F1;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #2C3E50; -fx-padding: 20;">
            <Button fx:id="btnVolver" text="⬅ Volver" onAction="#volverMenu"
                    style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-size: 14; -fx-background-radius: 5;"/>
            <Label text="Gestión de Cursos" textFill="white">
                <font>
                    <Font name="System Bold" size="28"/>
                </font>
            </Label>
        </HBox>
    </top>

    <center>
        <VBox spacing="20" style="-fx-padding: 20;">

            <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;">
                <Label text="Información del Curso" style="-fx-font-size: 18; -fx-font-weight: bold;"/>

                <GridPane hgap="10" vgap="15">
                    <Label text="Nombre del Curso:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="txtNombreCurso" promptText="Ej: Guitarra Básica" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="250"/>

                    <Label text="Duración (semanas):" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="txtDuracion" promptText="12" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Instrumento:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <ComboBox fx:id="comboInstrumento" promptText="Seleccione instrumento" GridPane.columnIndex="1" GridPane.rowIndex="2" prefWidth="250"/>

                    <Label text="Nivel:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <ComboBox fx:id="comboNivel" promptText="Seleccione nivel" GridPane.columnIndex="1" GridPane.rowIndex="3" prefWidth="250"/>
                </GridPane>

                <HBox spacing="10" alignment="CENTER">
                    <Button fx:id="btnCrearCurso" text="➕ Crear Curso" onAction="#crearCurso"
                            style="-fx-background-color: #27AE60; -fx-text-fill: white; -fx-font-size: 14; -fx-background-radius: 5;" prefWidth="130"/>
                    <Button fx:id="btnEditarCurso" text="✏️ Editar" onAction="#editarCurso"
                            style="-fx-background-color: #F39C12; -fx-text-fill: white; -fx-font-size: 14; -fx-background-radius: 5;" prefWidth="130"/>
                    <Button fx:id="btnEliminarCurso" text="🗑️ Eliminar" onAction="#eliminarCurso"
                            style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-size: 14; -fx-background-radius: 5;" prefWidth="130"/>
                </HBox>
            </VBox>

            <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;">
                <Label text="Cursos Disponibles" style="-fx-font-size: 18; -fx-font-weight: bold;"/>

                <TableView fx:id="tablaCursos" prefHeight="300">
                    <columns>
                        <TableColumn fx:id="colNombreCurso" text="Nombre" prefWidth="250"/>
                        <TableColumn fx:id="colDuracion" text="Duración (sem)" prefWidth="130"/>
                        <TableColumn fx:id="colInstrumento" text="Instrumento" prefWidth="150"/>
                        <TableColumn fx:id="colEstudiantes" text="Estudiantes" prefWidth="100"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>